# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# This app has no backend and no API keys today. This file exists so that if
# you add a service later, the pattern is already established: put the value
# here, read it in app.config.ts, never hardcode it in a source file.
#
# EAS project id is written automatically by `eas init`.
# EAS_PROJECT_ID=
