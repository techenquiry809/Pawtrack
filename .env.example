# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Read in app.config.ts and surfaced to the app through `extra`. Never import
# process.env directly from a source file — Metro does not reliably inline it,
# and a value that is undefined at runtime but defined at build time is a very
# annoying afternoon.

# EAS project id is written automatically by `eas init`.
# EAS_PROJECT_ID=

# ── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API. Both values are PUBLIC and ship in the app bundle.
#
# The anon key is a signed JWT asserting the `anon` role and nothing else. Row
# Level Security is what protects the data — see supabase/migrations/
# 20260828000200_rls.sql and the smoke test that proves it.
# The EXPO_PUBLIC_ prefix is what Supabase's own Expo guide uses, so it is the
# name to prefer. app.config.ts also accepts the unprefixed SUPABASE_URL /
# SUPABASE_ANON_KEY as a fallback.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ NEVER put SUPABASE_SERVICE_ROLE_KEY in this file or in .env.
# It bypasses RLS entirely. It belongs only in the environment of the purge
# job / alert sender, which run on a server you control — never in the app.

# ── Google Sign-In (native id-token flow) ──────────────────────────────────
# From the Google Cloud console credentials for this project.
#
# The WEB client id is the audience Supabase validates the id token against,
# so it is required even though there is no web build. Set the same value as
# the "Authorized Client ID" in Supabase → Auth → Providers → Google.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# The iOS client id with its dot-separated parts REVERSED, e.g.
#   123-abc.apps.googleusercontent.com  ->  com.googleusercontent.apps.123-abc
# Consumed by the google-signin config plugin as a URL scheme.
GOOGLE_IOS_URL_SCHEME=
